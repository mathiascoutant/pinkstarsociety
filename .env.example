# Copier vers .env et renseigner les valeurs

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGODB_DATABASE=pinkstarsociety

JWT_SECRET=changez-moi-long-aleatoire
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

FRONTEND_URL=http://localhost:5173
PORT=8080

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=

# E-mail confirmation rendez-vous après paiement Stripe
# Option A — Zimbra / OVH (prioritaire si ZIMBRA_SMTP_HOST est défini)
ZIMBRA_SMTP_HOST=smtp.mail.ovh.net
ZIMBRA_SMTP_PORT=465
ZIMBRA_EMAIL=contact@example.com
ZIMBRA_PASSWORD=

# Option B — SMTP générique (si pas de Zimbra)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Pink Star Society <no-reply@example.com>"

# E-mail planning (optionnel) — reçoit une copie / .ics si implémenté côté mail
PLANNING_EMAIL=

# Google Calendar — création automatique du RDV après paiement Stripe (sans import manuel).
# 1) Google Cloud Console → API Calendar activée → OAuth client « Application Web »
# 2) Scopes: https://www.googleapis.com/auth/calendar.events
# 3) Obtenir un refresh_token pour le compte Google du calendrier (ex. OAuth Playground ou script one-shot)
# 4) Renseigner les 3 variables ci-dessous ; GOOGLE_CALENDAR_ID=primary pour le calendrier principal du compte
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Frontend (Vite) — optionnel si tout passe par le proxy
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
